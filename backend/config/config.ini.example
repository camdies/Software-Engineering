[database]
# driver: mssql (SQL Server) 或 mysql
# mssql 使用 pyodbc + ODBC Driver 18 for SQL Server
# mysql 使用 PyMySQL
driver = mssql
host = localhost
port = 1433
user = sa
password = YOUR_DATABASE_PASSWORD
database = CourseManagementDB
pool_size = 10

[system]
log_level = INFO
log_dir = logs
backup_dir = backup
backup_retain_days = 30
session_timeout = 3600
max_login_attempts = 5
# 学期默认总周数（可在数据库中通过 semester_config 表按学期配置）
default_total_weeks = 20

[web]
jwt_secret =
jwt_expiration_hours = 24

[enrollment]
is_open = false
open_time = 2026-09-01 08:00:00
close_time = 2026-09-07 23:59:59
