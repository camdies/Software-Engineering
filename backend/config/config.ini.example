[database]
# driver: mysql (MySQL / MariaDB) 或 mssql (SQL Server)
# mysql 使用 PyMySQL（项目依赖已包含）
# mssql 使用 pyodbc + ODBC Driver 18 for SQL Server
driver = mysql
host = localhost
port = 3306
user = root
password = YOUR_MYSQL_PASSWORD
database = course_management_db
pool_size = 10

[system]
log_level = INFO
log_dir = logs
backup_dir = backup
backup_retain_days = 30
session_timeout = 3600
max_login_attempts = 5
# 学期默认总周数（可在数据库中通过 semester_config 表按学期配置）
default_total_weeks = 20

[web]
jwt_secret =
jwt_expiration_hours = 24

[enrollment]
is_open = false
open_time = 2026-09-01 08:00:00
close_time = 2026-09-07 23:59:59
